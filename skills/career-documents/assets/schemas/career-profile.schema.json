{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bmcnaboe/career-documents/schemas/career-profile.schema.json#1.0.0",
  "title": "CareerProfile",
  "type": "object",
  "required": ["schema_version", "applicant_ref", "authoritative_provider", "derived", "updated_at", "entities", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "applicant_ref": { "type": "string", "minLength": 1 },
    "authoritative_provider": { "enum": ["markdown", "basic_memory"] },
    "derived": { "type": "boolean" },
    "updated_at": { "type": "string", "format": "date-time" },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^(contact|experience|achievement|education|skill|project|credential|patent|publication)_[0-9A-HJKMNP-TV-Z]{26}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
    "provenance": {
      "type": "object",
      "required": ["source_id", "method", "recorded_at", "actor"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "pattern": "^src_[0-9A-HJKMNP-TV-Z]{26}$" },
        "method": { "enum": ["import", "extraction", "statement", "resolution"] },
        "recorded_at": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string" }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["field", "candidates"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string" },
        "candidates": {
          "type": "array", "minItems": 2,
          "items": { "type": "object", "required": ["value", "provenance"], "properties": { "value": {}, "provenance": { "$ref": "#/$defs/provenance" } } }
        },
        "resolution": {
          "type": "object", "required": ["value", "resolved_at", "by"],
          "properties": { "value": {}, "resolved_at": { "type": "string", "format": "date-time" }, "by": { "type": "string" }, "note": { "type": "string" } }
        }
      }
    },
    "link": { "type": "object", "required": ["label", "url"], "properties": { "label": { "type": "string" }, "url": { "type": "string", "format": "uri" } } },
    "common": {
      "type": "object",
      "required": ["id", "type", "visibility", "verification", "provenance", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["contact", "experience", "achievement", "education", "skill", "project", "credential", "patent", "publication"] },
        "visibility": { "enum": ["public", "restricted", "private"] },
        "verification": { "enum": ["unverified", "imported", "applicant_verified", "externally_verified"] },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
        "positioning": { "type": "array", "items": { "enum": ["executive", "builder"] }, "uniqueItems": true },
        "tags": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "entity": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "oneOf": [
            { "properties": { "type": { "const": "contact" }, "name": { "type": "string" }, "headline": { "type": "string" }, "location": { "type": "string" }, "email": { "type": "string", "format": "email" }, "phone": { "type": "string" }, "links": { "type": "array", "items": { "$ref": "#/$defs/link" } } }, "required": ["name"] },
            { "properties": { "type": { "const": "experience" }, "organization": { "type": "string" }, "title": { "type": "string" }, "employment_type": { "type": "string" }, "location": { "type": "string" }, "start_date": { "$ref": "#/$defs/date" }, "end_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }, "summary": { "type": "string" }, "achievement_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "skill_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } } }, "required": ["organization", "title", "start_date"] },
            { "properties": { "type": { "const": "achievement" }, "statement": { "type": "string", "minLength": 1 }, "metrics": { "type": "array", "items": { "type": "object", "required": ["value"], "properties": { "value": { "type": "string" }, "unit": { "type": "string" }, "context": { "type": "string" } } } }, "parent_id": { "$ref": "#/$defs/id" }, "skill_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } } }, "required": ["statement", "parent_id"] },
            { "properties": { "type": { "const": "education" }, "institution": { "type": "string" }, "degree": { "type": "string" }, "field_of_study": { "type": "string" }, "start_date": { "$ref": "#/$defs/date" }, "end_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }, "honors": { "type": "array", "items": { "type": "string" } } }, "required": ["institution"] },
            { "properties": { "type": { "const": "skill" }, "name": { "type": "string" }, "category": { "type": "string" }, "level": { "enum": ["familiar", "working", "expert"] }, "evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } } }, "required": ["name"] },
            { "properties": { "type": { "const": "project" }, "name": { "type": "string" }, "role": { "type": "string" }, "organization": { "type": "string" }, "start_date": { "$ref": "#/$defs/date" }, "end_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }, "summary": { "type": "string" }, "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }, "achievement_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } } }, "required": ["name"] },
            { "properties": { "type": { "const": "credential" }, "name": { "type": "string" }, "issuer": { "type": "string" }, "issued_date": { "$ref": "#/$defs/date" }, "expires_date": { "$ref": "#/$defs/date" }, "url": { "type": "string", "format": "uri" } }, "required": ["name", "issuer"] },
            { "properties": { "type": { "const": "patent" }, "title": { "type": "string" }, "number": { "type": "string" }, "status": { "enum": ["pending", "granted"] }, "filing_date": { "$ref": "#/$defs/date" }, "grant_date": { "$ref": "#/$defs/date" }, "url": { "type": "string", "format": "uri" } }, "required": ["title", "status"] },
            { "properties": { "type": { "const": "publication" }, "title": { "type": "string" }, "venue": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "url": { "type": "string", "format": "uri" } }, "required": ["title"] }
          ]
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["source_id", "kind", "location", "captured_at"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "pattern": "^src_[0-9A-HJKMNP-TV-Z]{26}$" },
        "kind": { "enum": ["resume_docx", "resume_pdf", "network_export", "note", "url", "statement"] },
        "location": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
