.DS_Store
__pycache__/
*.pyc

# Ralph run state is transient, except the command policy: worktrees carry it
# via git, and the loop refuses to start without it. `.ralph/*` (not `.ralph/`)
# so the negation can apply.
.ralph/*
!.ralph/command-policy
.ralph-postmortems/

# The repository is the plugin, so anything tracked here is cloned into every
# install. A project-scope MCP config is developer-local: keep it out of the
# package. `check_inventory.py` fails if it becomes tracked again.
.mcp.json
